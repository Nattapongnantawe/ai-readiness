# ชี้ไปที่ฐาน jobmarket ของ Module 1-3 (ใส่รหัสผ่าน postgres ของคุณ)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/jobmarket
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
USE_FAKE_EMBEDDINGS=false
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string
CRAWLER_ENTRYPOINT=app.crawler_bridge:demo_crawl
