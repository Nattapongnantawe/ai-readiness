# ชี้ไปที่ฐาน jobmarket ของ Module 1-3 (ใส่รหัสผ่าน postgres ของคุณ)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/jobmarket
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
USE_FAKE_EMBEDDINGS=false
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string

# ---------- ระบบดึงข้อมูลอัตโนมัติ (หน้า ผู้ดูแล → Crawler) ----------
# path ของโฟลเดอร์จริงบนเครื่อง (แก้ให้ตรง)
PIPELINE_DIR=C:\projeb\pipeline
JOBTHAI_DIR=C:\projeb\jobthai_v3
JOBBKK_DIR=C:\projeb\jobbkk_v341
# python ของแต่ละโฟลเดอร์ (ว่าง = <โฟลเดอร์>\venv\Scripts\python.exe และ pipeline ใช้ python ที่รัน API นี้)
# PIPELINE_PYTHON=C:\projeb\pipeline\venv\Scripts\python.exe
# JOBTHAI_PYTHON=
# JOBBKK_PYTHON=
# หมวดที่ JobThai จะวนดึง (คั่นด้วย |) : jobtype=7 คอมพิวเตอร์/ไอที, subjobtype=116 วิศวกรไฟฟ้า/อิเล็กทรอนิกส์
JOBTHAI_URLS=https://www.jobthai.com/th/jobs?jobtype=7|https://www.jobthai.com/th/jobs?subjobtype=116
# JobBKK: ว่าง = ใช้ LISTING_URL ใน config.py ของ JobBKK
JOBBKK_URLS=
# งานที่ส่งให้ Gemini ต่อรอบ (กันโควตาหมด) และเวลาสูงสุดต่อขั้น (นาที)
EXTRACT_LIMIT_PER_RUN=500
# หน่วงระหว่าง request (วินาที สุ่มในช่วง) — ถ้าเว็บตอบ 429/503/5xx/timeout scraper จะชะลอเอง 2 เท่า
# CRAWL_DELAY=4-7
# งานเดิมที่การ์ดในหน้ารายการบอกว่า "อัปเดต" (วันที่ใหม่กว่าที่เก็บ) เปิดดูใหม่ได้สูงสุดกี่งานต่อหมวดต่อรอบ
# MAX_UPDATES_PER_RUN=50
# TIMEOUT_CRAWL_MIN=240
# TIMEOUT_EXTRACT_MIN=180

# Search / Gap tuning (optional)
# SEARCH_MAX_RESULTS=200
# GAP_SUGGEST_MIN=0.55
# GAP_MISSING_MIN_JOBS=10
